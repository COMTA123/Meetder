# Copy this file to .env and change the values.
# Used by docker-compose.yml (all optional; defaults shown).

POSTGRES_USER=meetion
POSTGRES_PASSWORD=meetion_pass
POSTGRES_DB=meetion

# Only needed when running locally with `node index.js` (not Docker).
# Note: this is read by your shell/app, not by docker-compose (it builds its own).
# DATABASE_URL=postgres://meetion:meetion_pass@localhost:5432/meetion
# PORT=3000
